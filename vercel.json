{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "rivierarrival-samples.vercel.app" }
      ],
      "destination": "https://www.rivieraarrival.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/journal.html",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/journal/index.html",
      "destination": "/journal/",
      "permanent": true
    },
    {
      "source": "/admin",
      "destination": "/admin/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
